# ==============================================================
# UVP 绿色安装包（Windows）—— nginx 配置文件模板
#
# 职责（与 Linux 版一致）：① 托管前端（Vue 构建产物）② HTTPS 终止 ③ 反向代理到后端
#
# ⛔ 本文件里的路径由 uvp-gb28181-ctl.ps1 启动时按实际安装目录改写（占位符 @ROOT@），
#   不要手工改包内的模板。
#
# ⛔⛔ 与 Linux 版的三处差异（改的时候别照抄 Linux 模板）：
#   1) 路径一律写成**正斜杠**且**加引号**：Windows 安装目录可能带空格或中文，
#      nginx 的 `\` 会被当转义符吃字符。
#   2) 去掉 `worker_processes auto` 之外的 Linux 专属调优项（sendfile/tcp_nopush/
#      file_aio 在 Windows 上不受支持，写了轻则被忽略、重则起不来）。
#   3) 临时目录必须**先存在**（nginx 在 Windows 上不会自建），由 ctl 负责建。
#
# ⛔ 端口规划（与 uvp-gb28181-ctl.ps1 的变量必须一致）：
#   51000 nginx HTTPS（@HTTPS_PORT@）  51001 nginx HTTP（@PLAIN_HTTP_PORT@）
#   51002 后端 HTTP（@BACKEND_PORT@）  51003 Redis
#   51004-51013 ZLM    51014-51063 ZLM RTP 动态段    51064 SIP
#==============================================================

worker_processes  auto;

pid       "@ROOT@/run/nginx.pid";
error_log "@ROOT@/logs/nginx-error.log" warn;

events {
    worker_connections  1024;
}

http {
    include       "@ROOT@/vendor/nginx/conf/mime.types";
    default_type  application/octet-stream;

    client_body_temp_path "@ROOT@/run/nginx-client-body";
    proxy_temp_path       "@ROOT@/run/nginx-proxy";
    fastcgi_temp_path     "@ROOT@/run/nginx-fastcgi";
    uwsgi_temp_path       "@ROOT@/run/nginx-uwsgi";
    scgi_temp_path        "@ROOT@/run/nginx-scgi";

    log_format uvp '$remote_addr - [$time_local] "$request" $status $body_bytes_sent '
                   '"$http_referer" "$http_user_agent" rt=$request_time';
    access_log "@ROOT@/logs/nginx-access.log" uvp;

    keepalive_timeout  65;
    server_tokens off;
    client_max_body_size 1024m;

    gzip              on;
    gzip_min_length   1k;
    gzip_comp_level   5;
    gzip_vary         on;
    gzip_types        text/plain text/css application/json application/javascript
                      application/xml text/xml image/svg+xml font/woff font/woff2;
    gzip_proxied      any;

    upstream uvp_backend {
        server 127.0.0.1:@BACKEND_PORT@;
        keepalive 32;
    }

    # ============================================================
    # HTTPS（自签名）
    # ============================================================
    server {
        listen      @HTTPS_PORT@ ssl;
        http2       on;
        server_name _;

        ssl_certificate      "@ROOT@/vendor/nginx/conf/uvp.crt";
        ssl_certificate_key  "@ROOT@/vendor/nginx/conf/uvp.key";
        ssl_protocols        TLSv1.2 TLSv1.3;
        ssl_ciphers          ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers off;
        ssl_session_timeout  1h;

        root  "@ROOT@/resource/public";
        index index.html;

        location /static/ {
            expires 30d;
            add_header Cache-Control "public, immutable";
            try_files $uri =404;
        }

        # ⛔⛔⛔ 必须有这一条，否则所有用户上传的文件都取不到：
        #   后端 GetFileUrl 生成的是 /public/uploads/...，而 root 已指向 resource/public
        #   ⇒ 少一个 /public 前缀就会落到 SPA 回落，返回 HTTP 200 + HTML，
        #     浏览器静默显示不出图，全程零报错。
        location /public/uploads/ {
            alias "@ROOT@/resource/public/uploads/";
            location ~ \.\.(php|jsp|asp|sh|py|pl|cgi)$ {
                deny all;
            }
            autoindex off;
            expires 7d;
            add_header Cache-Control "public";
        }

        location /public/ {
            alias "@ROOT@/resource/public/";
            autoindex off;
        }

        # ⚠️ /api/ 与 /gb28181/ 必须列在 SPA 回落之前
        location /api/ {
            proxy_pass http://uvp_backend;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection        "";
            proxy_connect_timeout 15s;
            proxy_send_timeout    300s;
            proxy_read_timeout    300s;
            proxy_buffering       off;
        }

        location /gb28181/ {
            proxy_pass http://uvp_backend;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection        "";
        }

        location / {
            try_files $uri $uri/ /index.html;
        }

        location ~ /\. {
            deny all;
        }
    }

    # ============================================================
    # HTTP：跳 HTTPS（/api/ 与 /gb28181/ 保留明文，扫码用）
    # ============================================================
    server {
        listen      @PLAIN_HTTP_PORT@;
        server_name _;

        location /api/ {
            proxy_pass http://uvp_backend;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header Connection        "";
            proxy_buffering off;
        }

        location /gb28181/ {
            proxy_pass http://uvp_backend;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header Connection        "";
        }

        location /public/uploads/ {
            alias "@ROOT@/resource/public/uploads/";
            location ~ \.\.(php|jsp|asp|sh|py|pl|cgi)$ {
                deny all;
            }
            autoindex off;
            expires 7d;
            add_header Cache-Control "public";
        }

        location /public/ {
            alias "@ROOT@/resource/public/";
            autoindex off;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }
}
