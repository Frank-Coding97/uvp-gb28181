# UVP-GB28181 容器版部署参数（复制成 .env 后按需修改）
#
# ⛔ .env 里**不要**写数据库口令等业务凭据：容器版默认用 SQLite，
#    配置文件 config.yml 单独放在 config/ 下并由安装脚本生成。
#    这个文件只描述「装在哪、占哪些端口、以什么身份跑」。

# ---- 安装根：所有持久化数据都在这里，卸载/迁移只要搬这一个目录 ----
UVP_ROOT=/opt/uvp-gb28181

# ---- 版本与镜像前缀 ----
# ⛔ 版本必须显式写死：禁止用 latest（升级体系靠固定 tag + config id 判定身份，
#    用 latest 会让人无法判断"现在跑的到底是哪一个构建"）。
UVP_VERSION=1.1.4
UVP_IMAGE_PREFIX=uvp-gb28181

# ---- 运行身份（非 root）----
UVP_BUSINESS_UID=10001
UVP_BUSINESS_GID=10001

# ---- 端口规划（整段 51000-51064，与绿色包一致，防火墙一条规则覆盖）----
# ⛔ 要换整段就只改 UVP_PORT_BASE，让 install.sh 自己派生下面 5 个 + SIP；
#    逐个改容易漏，改完就不是"连续段"了（install.sh 会告警但不会拦住你）。
# UVP_PORT_BASE=53000
UVP_HTTPS_PORT=51000
UVP_HTTP_PORT=51001
UVP_BACKEND_PORT=51002
UVP_REDIS_PORT=51003
UVP_ZLM_HTTP_PORT=51004
# SIP 端口 = 段基址 + 64。它**不映射、不进 config.yml**，只作为首次登录引导页的
# 默认值下发给前端（后端读 UVP_DEFAULT_SIP_PORT，见 compose.yml）。
# ⛔ 别指望前端构建期注入的那个值：那是打镜像那一刻的常量，段一平移就落在段外。
UVP_SIP_PORT=51064

# ---- 升级助手 socket 目录（宿主机侧，业务容器只挂这一个目录，不挂 docker.sock）----
UVP_UPDATER_SOCKET_DIR=/run/uvp-updater

# ---- Redis 内存上限 ----
UVP_REDIS_MAXMEMORY=512mb

# ---- 部署密钥（install.sh 会自动生成，一般不用手填）----
# ⛔⛔ 这两个**不要改**，也不要在多套部署之间复用同一份：
#   · UVP_OPENAPI_MASTER_KEY 换了 ⇒ 已签发的 OpenAPI 客户端凭据全部失效；
#   · UVP_SIP_TRACE_ENCRYPTION_KEY 换了 ⇒ 历史 SIP 报文的密文解不开。
# 格式约定见 install.sh「密钥」一节；手填时 OpenAPI 那个必须是
# 32 字节的无填充 base64url（43 字符），SIP trace 那个用标准 base64（44 字符）。
# UVP_OPENAPI_MASTER_KEY=
# UVP_SIP_TRACE_ENCRYPTION_KEY=
