# ==============================================================
# UVP 绿色安装包 —— nginx 配置文件
#
# 职责：① 托管前端（Vue 构建产物）  ② HTTPS 终止  ③ 反向代理到后端
#
# ⛔ 为什么前端要放 nginx 而不是让后端托管：
#   后端自带静态服务时，前端页面和 API 只能共用一个端口，于是「要么全 HTTP、
#   要么全 HTTPS」，扫码接入拿不到注册信息（App 撞自签名证书）。
#   拆开后：nginx 同时提供管理页面和设备入口，后端留在纯 HTTP 的内网端口上。
#   二维码与抓拍回传地址由设备请求经过的 nginx 入口自动派生，设备不直接访问后端。
#
# ⛔ 端口规划（与 uvp-gb28181-ctl.sh 的变量必须一致；完整表见同目录 PORTS.md）：
#   51000 nginx HTTP         ← **默认入口**；并为 /api/ 与 /gb28181/ 留明文（@PLAIN_HTTP_PORT@）
#   51001 nginx HTTPS        ← 开启 HTTPS 后浏览器访问（@HTTPS_PORT@，默认关闭）
#   ⛔ 2026-10-19 起这两个端口**互换过**（旧版 HTTPS 51000 / HTTP 51001）。
#     存量实例的 data/https/settings.json 由 ctl.sh 在启动时自动迁移，见那段注释。
#   51002 后端 HTTP          ← 仅由本机 nginx 转发，**不设 TLS**（@BACKEND_PORT@）
#   51003 Redis（仅回环）    51004-51013 ZLM 各协议
#   51014-51063 ZLM RTP 动态段    51064 SIP（UDP+TCP，引导页预填）
#
#   ⇒ 整段 51000-51064 连续无空洞，防火墙一条规则即可覆盖（见 PORTS.md）。
#
# ⛔ 本文件里的路径由 uvp-gb28181-ctl.sh 启动时按实际安装目录改写（占位符 @ROOT@），
#   不要手工改包内的模板。
#==============================================================

# ---------------- 工作进程身份（由 ctl.sh 渲染时填入）----------------
# ⛔⛔ 必须显式声明，且**用户与组都要写全**。原因：
#   源码编译的 nginx，默认 user/group 都是 nobody，运行期按**名字**解析；
#   而 Debian 系（Ubuntu / UOS）里 nobody 用户的**主组叫 nogroup**，
#   系统里根本没有 nobody 这个组 ⇒ 报 `getgrnam("nobody") failed`，nginx 直接起不来。
#   症状极具误导性：ZLM / Redis / 后端全都正常，只有 nginx 挂（已实测）。
# ⛔ 只写 `user nobody;` 也不行：nginx 在**只给一个参数**时会去查
#   「与用户同名的组」（不是用户的主组），Debian 上照样失败（已实测）。
# ⇒ 只能把「用户 + 其主组名」都写出来，而主组名随发行版而变
#   （RPM 系是 nobody、Debian 系是 nogroup），所以由 uvp-gb28181-ctl.sh
#   在渲染时用 `id -gn` 问出真实主组名填进来，**不写死、不猜**。
@NGINX_WORKER_DIRECTIVE@

worker_processes  auto;
# ⛔ pid 写在包内而不是 /run：绿色包不写系统目录，多实例也不会互相覆盖。
pid  @ROOT@/run/nginx.pid;
error_log @ROOT@/logs/nginx-error.log warn;

events {
    worker_connections  1024;
}

http {

    # 上游若已声明协议（外层 TLS 终止：NPM / SLB / 客户 nginx），沿用它的；
    # 只有直连（没有该头）时才用本跳 $scheme。
    # ⛔ 不要写回 `$scheme`：内层这一跳恒为 http，会把上游的 https 覆盖掉，
    #   于是一切「后端拼绝对地址」的功能（对讲 WHIP 上行、抓拍回调、扫码配网）
    #   都会拿到 http 地址，在 https 页面里被浏览器判为混合内容。
    map $http_x_forwarded_proto $uvp_forwarded_proto {
        default $http_x_forwarded_proto;
        ""      $scheme;
    }

    # 设备入口只信任内置 nginx 实际连接的代理地址。公网客户端伪造
    # X-Forwarded-Proto 不能改变二维码或抓拍回传地址。
    geo $remote_addr $uvp_device_proxy_trusted {
        default          0;
        127.0.0.1        1;
        ::1              1;
        10.0.0.0/8       1;
        172.16.0.0/12    1;
        192.168.0.0/16   1;
    }
    map $http_host $uvp_device_host_without_port {
        ~^\[(?<uvp_device_ipv6>[0-9A-Fa-f:.]+)\](?::[0-9]+)?$ "[$uvp_device_ipv6]";
        ~^(?<uvp_device_name>[^:]+)(?::[0-9]+)?$                 $uvp_device_name;
        default "";
    }
    map "$uvp_device_proxy_trusted:$http_x_forwarded_proto" $uvp_device_external_base {
        ~^1:(?<uvp_device_external_scheme>https?)$ "$uvp_device_external_scheme://$http_host";
        default "";
    }
    map $uvp_device_external_base $uvp_device_http_base {
        ""      "http://$http_host";
        default $uvp_device_external_base;
    }
    map $uvp_device_external_base $uvp_device_https_base {
        ""      "http://$uvp_device_host_without_port:@PLAIN_HTTP_PORT@";
        default $uvp_device_external_base;
    }
    include @ACTIVE_ROOT@/vendor/nginx/conf/mime.types;
    default_type  application/octet-stream;

    # 临时目录放包内（/tmp 可能被 noexec 挂载）
    client_body_temp_path @ROOT@/run/nginx-client-body;
    proxy_temp_path      @ROOT@/run/nginx-proxy;
    fastcgi_temp_path    @ROOT@/run/nginx-fastcgi;
    uwsgi_temp_path      @ROOT@/run/nginx-uwsgi;
    scgi_temp_path       @ROOT@/run/nginx-scgi;

    # ---------------- 日志 ----------------
    # ⛔ 单独一份 access log：排障时要把「页面请求」和「接口请求」分开看，
    #   混在应用日志里会因为量太大而找不到那一条。
    log_format uvp '$remote_addr - [$time_local] "$request" $status $body_bytes_sent '
                   '"$http_referer" "$http_user_agent" rt=$request_time';
    access_log @ROOT@/logs/nginx-access.log uvp;

    sendfile      on;
    tcp_nopush    on;
    keepalive_timeout  65;
    server_tokens off;      # 不暴露 nginx 版本
    client_max_body_size 1024m;   # ⛔ 录像/抓拍上传：默认 1m 会直接 413

    gzip              on;
    gzip_min_length   1k;
    gzip_comp_level   5;
    gzip_vary         on;
    gzip_types        text/plain text/css application/json application/javascript
                      application/xml text/xml image/svg+xml font/woff font/woff2 application/wasm;
    # ⛔ WASM 可压缩；不 gzip 已压缩媒体（vorbis/flv/mp4）
    gzip_proxied      any;

    # ---------------- 上游：后端 ----------------
    upstream uvp_backend {
        server 127.0.0.1:@BACKEND_PORT@;
        keepalive 32;
    }

    # ============================================================
    # HTTPS（自签名）
    # ============================================================
    # UVP_HTTPS_BEGIN
    server {
        listen      @HTTPS_PORT@ ssl;
        listen      [::]:@HTTPS_PORT@ ssl;
        http2       on;
        server_name _;

        # ⛔⛔ 自签名证书：CN 只能填一个主机名，浏览器对「IP 访问 + CN 不匹配」
        #   会直接拦下（ERR_CERT_COMMON_NAME_INVALID），扫码更是第一步就失败。
        #   ⇒ 交付说明必须告诉客户：把证书的 CN 填成他们实际访问的域名，
        #     或让手机/电脑信任这个自签根证书。**换成真证书是根本解法。**
        ssl_certificate      @ROOT@/vendor/nginx/conf/uvp.crt;
        ssl_certificate_key  @ROOT@/vendor/nginx/conf/uvp.key;
        ssl_protocols        TLSv1.2 TLSv1.3;
        ssl_ciphers          ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers off;
        ssl_session_cache    shared:UVP:4m;
        ssl_session_timeout  1h;

        root @ACTIVE_ROOT@/resource/public;
        index index.html;

        # ---------------- 前端 ----------------
        # ⛔ 带 hash 的静态资源（/static/js/xxx.<hash>.js）可以长期缓存：
        #   文件名变了浏览器就会重新拉，这是构建工具的契约。
        # 内容摘要覆盖整组主脚本、worker 和 WASM；只有版本目录允许长期缓存。
        location ~ "^/easyplayer/[0-9a-f]{16}/" {
            expires 30d;
            add_header Cache-Control "public, immutable";
            try_files $uri =404;
        }

        # 旧页面仍可用固定路径；发布后必须校验，防止混用旧解码器。
        location /easyplayer/ {
            add_header Cache-Control "no-cache";
            try_files $uri =404;
        }

        location = /index.html {
            add_header Cache-Control "no-cache";
        }

        location /static/ {
            expires 30d;
            add_header Cache-Control "public, immutable";
            try_files $uri =404;
        }

        # 通道快照由后端写入安装根的 resource/public；升级后的静态资源则位于活动 release。
        # 快照 URL 必须从持久安装根读取，不能随 current 切换到新 release。
        location /public/gb-channel-snapshot/ {
            alias @ROOT@/resource/public/gb-channel-snapshot/;
            autoindex off;
        }

        # ---------------- 用户上传的资源 ----------------
        # ⛔⛔⛔ 必须有这一条，否则**所有用户上传的文件都取不到**。
        #   为什么：`root` 指向 resource/public，所以磁盘上的 uploads/xxx.png
        #   对应的 URL 是 `/uploads/xxx.png`（**没有** /public 前缀）；
        #   而后端 GetFileUrl 生成的却是
        #     `httpserver.serverrootpath` + `/uploads/...` = `/public/uploads/...`
        #   （config.example.yml 里 serverrootpath 默认就是 "/public"）。
        #   ⇒ 两边差一个 /public 前缀，nginx 匹配不到 ⇒ 落到 SPA 回落
        #     把 index.html 返回给图片请求 ⇒ **HTTP 200 但内容是 HTML**，
        #     浏览器静默显示不出图，**全程零报错**（实测踩过：admin 头像出不来）。
        #
        # ⚠️ 这里用 alias 而不是改 root：`/public/uploads/` 映射到
        #   `resource/public/uploads/`（去掉 /public 前缀）。
        location /public/uploads/ {
            alias @ROOT@/resource/public/uploads/;
            # ⚠️ 上传目录是**用户可写**的：关掉脚本执行、限制方法。
            location ~ \.\.(php|jsp|asp|sh|py|pl|cgi)$ {
                deny all;
            }
            autoindex off;
            # 上传的文件名带日期与 uuid，不做immutable（避免同名覆盖后拿到旧缓存）
            expires 7d;
            add_header Cache-Control "public";
        }

        # 其余 /public/ 下的静态文件（图纸、文档等）
        location /public/ {
            alias @ACTIVE_ROOT@/resource/public/;
            autoindex off;
        }

        # ⛔ SPA 前端路由：任何未匹配的路径都交回 index.html，
        #   否则刷新 /devices/123 会 404（前端是 history 路由）。
        #   ⚠️ 但 /api/、/gb28181/ 与 /openapi/ 必须列在前面 —— 否则它们会被这条规则
        #   吞掉、返回 HTML，前端拿到 HTML 当 JSON 解析 ⇒ 报一个和真因无关的错。
        location = /api/system/upgrade/import {
            client_max_body_size 9g;
            client_body_timeout 30m;
            proxy_pass http://uvp_backend;
            proxy_http_version 1.1;
            # ⛔⛔ 2026-10-20 起 Host 用 $http_host（带端口）而不是 $host：
            #   nginx 的 $host 丢端口，而后端（如抓拍 UploadURL、扫码配网）
            #   从 Host/X-Forwarded-Host 派生「设备回连地址」⇒ 端口一丢，
            #   https 部署下设备被指向 443 死地址，图传不回来且平台零报错。
            proxy_set_header Host              $http_host;
            proxy_set_header X-Forwarded-Host  $http_host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $uvp_forwarded_proto;
            proxy_set_header X-UVP-Device-Base-URL $uvp_device_https_base;
            proxy_set_header Connection        "";
            proxy_connect_timeout 15s;
            proxy_send_timeout    30m;
            proxy_read_timeout    30m;
            proxy_request_buffering off;
            proxy_buffering       off;
        }

        location /api/ {
            proxy_pass http://uvp_backend;
            proxy_http_version 1.1;
            # ⛔⛔ 2026-10-20 起 Host 用 $http_host（带端口）而不是 $host：
            #   nginx 的 $host 丢端口，而后端（如抓拍 UploadURL、扫码配网）
            #   从 Host/X-Forwarded-Host 派生「设备回连地址」⇒ 端口一丢，
            #   https 部署下设备被指向 443 死地址，图传不回来且平台零报错。
            proxy_set_header Host              $http_host;
            proxy_set_header X-Forwarded-Host  $http_host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $uvp_forwarded_proto;
            proxy_set_header X-UVP-Device-Base-URL $uvp_device_https_base;
            proxy_set_header Connection        "";
            # 上传/下载超时给足：录像片段可能上百 MB
            proxy_connect_timeout 15s;
            proxy_send_timeout    300s;
            proxy_read_timeout    300s;
            # ⛔ 必须关缓冲：大文件（录像下载）时后端边发 nginx 边缓冲，
            #   内存会涨且延迟高一截
            proxy_buffering       off;
        }

        # GB28181 相关：扫码落地页 + 免鉴权兑换接口。设备入口统一经 nginx。
        location /gb28181/ {
            proxy_pass http://uvp_backend;
            proxy_http_version 1.1;
            # ⛔⛔ 2026-10-20 起 Host 用 $http_host（带端口）而不是 $host：
            #   nginx 的 $host 丢端口，而后端（如抓拍 UploadURL、扫码配网）
            #   从 Host/X-Forwarded-Host 派生「设备回连地址」⇒ 端口一丢，
            #   https 部署下设备被指向 443 死地址，图传不回来且平台零报错。
            proxy_set_header Host              $http_host;
            proxy_set_header X-Forwarded-Host  $http_host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $uvp_forwarded_proto;
            proxy_set_header X-UVP-Device-Base-URL $uvp_device_https_base;
            proxy_set_header Connection        "";
        }

        location ~ ^/openapi(?:/|$) {
            proxy_pass http://uvp_backend;
            proxy_http_version 1.1;
            proxy_set_header Host              $http_host;
            proxy_set_header X-Forwarded-Host  $http_host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $uvp_forwarded_proto;
            proxy_set_header X-UVP-Device-Base-URL $uvp_device_https_base;
            proxy_set_header Connection        "";
        }

        # 设备抓拍/录像等落在 resource/public 下的其它前缀，同样交给后端处理
        location / {
            try_files $uri $uri/ /index.html;
        }

        # 兜底：不在配置里出现的接口一律 404，且**不要**回落到 index.html
        location ~ /\. {
            deny all;
        }
    }

    # UVP_HTTPS_END

    # ============================================================
    # HTTP：跳 HTTPS
    #
    # ⛔ /api/、/gb28181/ 与 /openapi/ 保持明文转发。设备回传使用此 nginx 入口，
    #   不进入浏览器 HTTPS 跳转，也不直连后端端口。
    # ============================================================
    # UVP_HTTP_BEGIN
    server {
        listen      @PLAIN_HTTP_PORT@;
        listen      [::]:@PLAIN_HTTP_PORT@;
        server_name _;

        location /api/ {
            proxy_pass http://uvp_backend;
            proxy_http_version 1.1;
            # ⛔⛔ 2026-10-20 起 Host 用 $http_host（带端口）而不是 $host：
            #   nginx 的 $host 丢端口，而后端（如抓拍 UploadURL、扫码配网）
            #   从 Host/X-Forwarded-Host 派生「设备回连地址」⇒ 端口一丢，
            #   https 部署下设备被指向 443 死地址，图传不回来且平台零报错。
            proxy_set_header Host              $http_host;
            proxy_set_header X-Forwarded-Host  $http_host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-UVP-Device-Base-URL $uvp_device_http_base;
            proxy_set_header Connection        "";
            proxy_buffering off;
        }

        location /gb28181/ {
            proxy_pass http://uvp_backend;
            proxy_http_version 1.1;
            # ⛔⛔ 2026-10-20 起 Host 用 $http_host（带端口）而不是 $host：
            #   nginx 的 $host 丢端口，而后端（如抓拍 UploadURL、扫码配网）
            #   从 Host/X-Forwarded-Host 派生「设备回连地址」⇒ 端口一丢，
            #   https 部署下设备被指向 443 死地址，图传不回来且平台零报错。
            proxy_set_header Host              $http_host;
            proxy_set_header X-Forwarded-Host  $http_host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-UVP-Device-Base-URL $uvp_device_http_base;
            proxy_set_header Connection        "";
        }

        location ~ ^/openapi(?:/|$) {
            proxy_pass http://uvp_backend;
            proxy_http_version 1.1;
            proxy_set_header Host              $http_host;
            proxy_set_header X-Forwarded-Host  $http_host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-UVP-Device-Base-URL $uvp_device_http_base;
            proxy_set_header Connection        "";
        }

        # 通道快照位于持久安装根；明文入口与 HTTPS 使用相同映射。
        location /public/gb-channel-snapshot/ {
            alias @ROOT@/resource/public/gb-channel-snapshot/;
            autoindex off;
        }

        # 用户上传的资源：明文入口也必须放行。
        # ⛔ 不能只留 HTTPS 那一条 —— 明文段的 `location /` 是 301 跳 HTTPS，
        #   而**图片/附件被301 跟随后是能通的**，只是多一跳；
        #   真正的问题是扫码/移动端若直接引明文地址（不跟随跳转）就拿不到图。
        #   规则与 HTTPS 段保持一致（alias 去掉 /public 前缀）。
        location /public/uploads/ {
            alias @ROOT@/resource/public/uploads/;
            location ~ \.\.(php|jsp|asp|sh|py|pl|cgi)$ {
                deny all;
            }
            autoindex off;
            expires 7d;
            add_header Cache-Control "public";
        }

        location /public/ {
            alias @ACTIVE_ROOT@/resource/public/;
            autoindex off;
        }

        location / {
            # ⛔ 必须带上 HTTPS 端口：`$host` **不含端口**，
            #   写成 `https://$host$request_uri` 会跳到 443 端口（那儿没有服务）
            #   ⇒ 客户从明文端口进来只会看到「打不开」，与真因完全对不上。
            return 301 https://$host:@HTTPS_PORT@$request_uri;
        }
    }
    # UVP_HTTP_END
}
