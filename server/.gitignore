# IDE 配置文件
.vscode/
.idea/
*.swp
*.swo
*~

# claude 相关文件夹不提交
.claude
CLAUDE.md
# .trae 文件夹不提交
.trae/

# payment_cert 文件夹不提交
payment_cert/

# 编译输出
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go 测试文件
*.test

# Go 覆盖率文件
*.out
*.prof

# 依赖管理
vendor/

# 环境配置文件
.env
.env.local
.env.production

# 日志文件
*.log
logs/
resource/logs/
resource/logs/*.log

# resource 目录配置 - 只提交 database 文件夹下的内容，public 文件夹本身不提交
/resource/*

# ⛔ 种子资源（绿色包要随包交付的静态文件，如 admin 默认头像）**必须入库**。
#   /resource/* 把整个 resource 目录排除了，而 resource/public 里的东西
#   绝大多数是**运行时产物**（前端 dist、用户上传的 uploads）—— 所以之前
#   从 git 拉代码的构建机上没有 uploads 目录，头像文件压根进不了包。
!/resource/seed-assets/
!/resource/database/
!/resource/public/
/resource/public/*

# 临时文件
tmp/
temp/

# 操作系统生成的文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Go 工作区文件
go.work
go.work.sum

# 二进制文件
/bin/
/dist/

# 配置文件备份
*.bak
*.backup
config/*.local.yml
config/config.yml

# config 目录配置 - 只提交明确的无凭据示例
/config/*
!/config/config.example.yml
!/config/openapi-revocation.example.yml

# 调试生成的文件
__debug_bin.exe*

.vscode/
# Roo
.roo/
/config/config.yml
/uvp-gb28181-linux
/resource/public/uploads
/.qoder

# plugins 目录配置 - 只提交 example 目录和 exampleinit.go
/plugins/*
!/plugins/example/
!/plugins/exampleinit.go
/plans
/AGENTS.md
# scripts 目录配置 - 只提交构建和文档生成脚本
/scripts/*
!/scripts/build-to-linux.bat
!/scripts/build-to-linux.sh
!/scripts/build-to-windows.bat
!/scripts/swagger.bat
!/scripts/swagger.sh
/.history
