  "newButtons": [
    {
      "title": "复制或分享播放地址",
      "permission": "gb28181:play:share",
      "parentPath": "/gb28181/multi-screen-playback",
      "apis": [],
      "source": [
        "web/src/views/gb28181/components/PlayConsoleLinked.vue:2967"
      ],
      "notes": "复制播放地址为前端业务动作；播放所需临时凭据仍由实时观看权限获取，不虚构分享API。",
