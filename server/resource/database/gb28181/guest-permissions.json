{
  "version": 1,
  "roleName": "游客",
  "description": "只读游客：允许业务查看、实时观看和录像回放；禁止下载、控制与修改",
  "pages": [
    "/home",
    "/gb28181/device-mgmt/index",
    "/gb28181/multi-screen-playback",
    "/gb28181/device-record-playback/:channelId",
    "/gb28181/cloud-recordings",
    "/gb28181/alarm-management"
  ],
  "permissions": [
    "gb28181:home:view",
    "gb28181:device:view",
    "gb28181:play:start",
    "gb28181:play:monitor",
    "gb28181:device-record:query",
    "gb28181:device-record:play"
  ],
  "bindings": [
    {
      "menuPath": "/home",
      "apis": [
        {
          "method": "GET",
          "path": "/api/users/profile"
        },
        {
          "method": "GET",
          "path": "/api/sysMenu/getRouters"
        },
        {
          "method": "POST",
          "path": "/api/users/logout"
        }
      ]
    },
    {
      "permission": "gb28181:home:view",
      "apis": [
        {
          "method": "GET",
          "path": "/api/gb28181/sip/dashboard/snapshot"
        },
        {
          "method": "GET",
          "path": "/api/gb28181/zlm/overview"
        }
      ]
    },
    {
      "permission": "gb28181:play:start",
      "apis": [
        {
          "method": "GET",
          "path": "/api/gb28181/sip/service-config/default-playback-protocol"
        },
        {
          "method": "GET",
          "path": "/api/gb28181/sip/service-config/playback-settings"
        },
        {
          "method": "GET",
          "path": "/api/gb28181/sip/service-config/fixed-address-playback"
        }
      ]
    }
  ],
  "allowedAPIs": [
    {
      "method": "DELETE",
      "path": "/api/gb28181/device-mgmt/channel/:id/playback-sessions/:sessionId"
    },
    {
      "method": "GET",
      "path": "/api/gb28181/alarms"
    },
    {
      "method": "GET",
      "path": "/api/gb28181/alarms/:id"
    },
    {
      "method": "GET",
      "path": "/api/gb28181/cloud-recordings/active"
    },
    {
      "method": "GET",
      "path": "/api/gb28181/cloud-recordings/files"
    },
    {
      "method": "GET",
      "path": "/api/gb28181/cloud-recordings/files/:id"
    },
    {
      "method": "GET",
      "path": "/api/gb28181/cloud-recordings/files/options"
    },
    {
      "method": "GET",
      "path": "/api/gb28181/device-mgmt/catalog/tree"
    },
    {
