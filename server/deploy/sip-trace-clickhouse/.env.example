# Bind to loopback when UVP and ClickHouse run on the same host.
CLICKHOUSE_BIND_IP=127.0.0.1

# Bootstrap account used only for ClickHouse administration and container health checks.
CLICKHOUSE_USER=uvp_bootstrap
CLICKHOUSE_PASSWORD=CHANGE_ME_BOOTSTRAP_PASSWORD

# Restricted account used by UVP SIP Trace.
UVP_SIP_TRACE_DATABASE=uvp_sip_trace
UVP_SIP_TRACE_USER=uvp_trace
UVP_SIP_TRACE_CLICKHOUSE_PASSWORD=CHANGE_ME_APPLICATION_PASSWORD
