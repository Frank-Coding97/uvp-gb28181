# ===== monorepo 顶层忽略 =====
# 各子项目(server/ web/)另有自己的 .gitignore,此处仅覆盖顶层与跨项目通用项

# 操作系统
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# AI 工具
.ai/
.claude/
.codex/
CLAUDE.md
AGENTS.md
.trae/
.roo/
.history/

# Go 构建产物 (server)
server/bin/
server/dist/
*.exe
*.test
*.out

# Node 依赖与构建产物 (web)
web/node_modules/
web/dist/
web/dist-ssr/

# 日志与临时
*.log
logs/
tmp/
temp/

# 环境与本地配置
.env
.env.local
.env.production

# VS Code dlv 调试临时二进制
server/__debug_bin*
__debug_bin*

# 编译出的服务端二进制
server/uvp-gb28181
server/main

# 本地 MCP / Playwright 调试配置(可能含密钥)
.mcp.json
.playwright-mcp/
server/.playwright-mcp/

# 本地 CI/CD 临时密钥（仅用于初始化 GitHub Secrets，严禁提交）
.ci-secrets/

# 发布产物(打包脚本输出,不入库)
release-output/

# 运行时上传目录(固件包/图片等测试数据,不入库)
server/uploads/

# 临时截图 / 调试 JSON(开发过程产物,不入库)
*.png
!web/public/**/*.png
!web/src/**/*.png
!server/**/*.png
check-*.json
test-long-text.json

# Local credential keys
**/secrets/cascade.key
**/secrets/.cascade-key-*

# 出包脚本的"预置源码包"目录（UVP_SRCDIR 指向它，容器里挂成 /src/.uvp-src）。
# 装的是 nginx/openssl/pcre2/zlib/redis 的官方 tar 包，合计 ~25MB ——
# 它们只是网络不稳时的离线兜底，不该进仓库（每次出包都能重新下）。
.uvp-src/

# 过程文档：AI 产出的规格/方案/任务记录/审查稿，只在本地参考，不入库。
# ⚠️ docs/releases/（发版脚本按版本号取用）与 docs/contact/（README 配图）**不在此列**，
#    它们是对外交付物，必须入库。
docs/specs/
docs/plans/
docs/tasks/
docs/audits/
docs/device-channel-tree/
docs/camera-first-frame-*.md
