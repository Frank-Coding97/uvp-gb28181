# ===== monorepo 顶层忽略 =====
# 各子项目(server/ web/)另有自己的 .gitignore,此处仅覆盖顶层与跨项目通用项

# 操作系统
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# AI 工具
.claude/
CLAUDE.md
AGENTS.md
.trae/
.roo/
.history/

# Go 构建产物 (server)
server/bin/
server/dist/
*.exe
*.test
*.out

# Node 依赖与构建产物 (web)
web/node_modules/
web/dist/
web/dist-ssr/

# 日志与临时
*.log
logs/
tmp/
temp/

# 环境与本地配置
.env
.env.local
.env.production

# VS Code dlv 调试临时二进制
server/__debug_bin*
__debug_bin*

# 编译出的服务端二进制
server/uvp-gb28181

# 本地 MCP / Playwright 调试配置(可能含密钥)
.mcp.json
.playwright-mcp/
server/.playwright-mcp/

# 临时截图 / 调试 JSON(开发过程产物,不入库)
*.png
!web/public/**/*.png
!web/src/**/*.png
!server/**/*.png
check-*.json
test-long-text.json
