# 开发环境
VITE_USER_NODE_ENV = development

# 路由模式 hash | history
VITE_ROUTER_MODE = hash

# 打包路径 开发环境地址前缀 (一般 '/' 或 './' 都可以，如果开发环境 '/' 打包预览白屏，请使用 './')
# 默认情况下，vite 会假设你的应用是被部署在一个域名的根路径上，所以这里 VITE_PUBLIC_PATH 为 '/'
VITE_PUBLIC_PATH = './'

# 浏览器 API 使用同源路径，避免 HttpOnly 下载票据在创建请求和原生下载之间丢失。
VITE_APP_BASE_URL = ''

# 开发服务器 HTTPS（默认 false = 走 HTTP，模拟器扫码接入不受影响）。
# 需要安全上下文的功能（对讲/麦克风、摄像头采集）才置 true：
#   ① 证书放 web/certs/dev.pem + dev-key.pem（mkcert 生成，目录已被 .git/info/exclude 忽略）
#   ② VITE_DEV_HTTPS=true pnpm dev   →  访问 https://<host>:5177
# 页面是 HTTPS 时 /api 请求仍由 vite 代理转发到后端 HTTP，后端无需任何 TLS 配置。
VITE_DEV_HTTPS = false

# 分片上传配置
VITE_CHUNK_SIZE = 5242880    # 分片  5M
VITE_CHUNK_CONCURRENCY = 3  # 并发数
VITE_CHUNK_LARGE_FILE_THRESHOLD = 52428800  # 大文件阈值 50M
VITE_CHUNK_MAX_RETRY = 3    # 最大重试次数
VITE_CHUNK_MAX_FILE_SIZE = 5368709120  # 最大文件大小 5GB